# 배포 이미지
IMAGE_PREFIX=ghcr.io/whs4-ruby/ruby
IMAGE_TAG=latest

# 기존 단일 대상(legacy) 구성에서만 쓰는 호스트 포트입니다.
# 아래 TARGET_CHOICES를 설정한 두 대상 운영에서는 각 Docker 내부 URL로 전달합니다.
# legacy 대상은 127.0.0.1 전용이 아니라 0.0.0.0(또는 Docker 브리지 주소)에 바인딩되어야 합니다.
TARGET_PORT=3000
# Public URL that receives protected traffic. The management dashboard uses this
# to link back to the active target when opened through an SSH tunnel.
PUBLIC_TARGET_ORIGIN=http://localhost
# Optional named targets for an experiment. URLs are internal Docker endpoints.
# The same allowlist is passed to Detection and Defense; the UI accepts IDs only.
# TARGET_CHOICES=legacy=http://host.docker.internal:3000,ruby-shop=http://ruby-web-target:8080,juice-shop=http://juice-shop-target:3000
# TARGET_DEFAULT_ID=legacy
# Production example with the benchmark stack on ruby_ai-defense-net:
# PUBLIC_TARGET_ORIGIN=http://YOUR_SERVER_IP
# TARGET_CHOICES=ruby-shop=http://ruby-web-target:8080,juice-shop=http://juice-shop-target:3000
# TARGET_DEFAULT_ID=ruby-shop

# Detection 정책
DETECTION_LEVEL=medium
CSRF_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
TRUST_PROXY=loopback,linklocal,uniquelocal
DCID_COOKIE_SECURE=true

# 로컬 Compose의 전달 전 공격 검사와 토큰 관찰
CRS_MODE=enforce
CRS_BLOCK_THRESHOLD=5
TOKEN_GATE_MODE=observe
TOKEN_GATE_SECRET=
TOKEN_GATE_EPOCH_S=300
TOKEN_GATE_GRACE_EPOCHS=1
# 경로 별칭 (defense/docs/path-alias-operations.md)
# off: 사용 안 함 / audit: 응답·요청을 바꾸지 않고 집계만 / observe: 응답 치환·쿠키 발급(원본도 전달)
# enforce: 원본 차단. 경로 파일에 enforce_ready와 검증 기록이 없으면 enforce여도 observe로 동작
PATH_ALIAS_MODE=off
PATH_ALIAS_EPOCH_S=1800
PATH_ALIAS_GRACE_EPOCHS=1
PATH_ALIAS_PREFIXES=/rest/,/api/
PATH_ALIAS_ROUTES_FILE=/app/config/juice-shop-routes.json
# 경로 파일을 적용할 대상 ID. 비우면 파일의 target_ids(juice-shop)를 씁니다. 로컬 legacy 대상은 legacy로 지정.
PATH_ALIAS_TARGET_IDS=
# 별칭 테이블: 두 Compose 모두 SQLite 파일(/app/alias-data/path-alias.sqlite3,
# defense-alias-data 볼륨)을 씁니다. 별도 DB 서비스나 비밀번호가 필요 없습니다.
# 이전 버전의 PATH_ALIAS_DB_URL/PATH_ALIAS_DB_PASSWORD/PATH_ALIAS_DB_POOL_SIZE는 더 이상 쓰지 않습니다.
PATH_ALIAS_MAX_REWRITE_BYTES=8388608
PATH_ALIAS_APP_ID=
# 즉시 교체 사유. reject는 모든 거부 사유를 뜻합니다. 만료(stale)·교체된(revoked) 별칭은 교체하지 않습니다.
# 원본 직접 호출은 차단만 하고 기존 탭 별칭을 유지합니다. direct를 추가하면 즉시 교체합니다.
PATH_ALIAS_ROTATE_ON=malformed_alias,foreign_alias
PATH_ALIAS_ROTATE_MIN_INTERVAL_S=5
# 쿠키를 돌려주지 않은(미확인) 클라이언트의 수명·상한과 전체 클라이언트 상한. 넘으면 503(enforce).
PATH_ALIAS_PENDING_TTL_S=300
PATH_ALIAS_MAX_PENDING_CLIENTS=10000
PATH_ALIAS_MAX_CLIENTS=100000
# 같은 클라이언트의 만료 별칭 GET/HEAD는 현재 별칭으로 307 이동 (POST 등은 재전송하지 않음)
PATH_ALIAS_STALE_REDIRECT=true
# 만료된 자기 별칭의 POST 등도 307로 보낼지(브라우저가 한 번 재전송). 비우면 경로 파일의
# stale_redirect_unsafe(기본 false)를 따르고, true/false는 경로 파일보다 우선합니다.
PATH_ALIAS_STALE_REDIRECT_UNSAFE=
# 만료·교체된 별칭을 알아보는 기간(초). 이 기간 안의 오래된 탭은 GET 307로 복구된다. 지나면 새로고침 필요.
PATH_ALIAS_TOMBSTONE_S=21600
PATH_ALIAS_COOKIE_SECURE=false

# 운영 배포 전에 각각 충분히 긴 서로 다른 값으로 설정하세요.
PAYLOAD_FINGERPRINT_KEY=
DCID_HMAC_SECRET=
ACCOUNT_ID_HASH_KEY=

# Account overlay detector key (stable 64-character hex value). The Deploy
# workflow derives this from DCID_HMAC_SECRET with a separate HMAC domain.
# For manual Compose deployments, set this value and preserve the overlay volumes.
OVERLAY_DETECTOR_KEY=

# 선택 사항: Juice Shop RS256 JWT 검증 공개키(PEM 한 줄 또는 배포 환경 주입)
ACCOUNT_JWT_PUBLIC_KEY=

# Detection 메모리/수명 한도
DCID_TTL_MS=2592000000
RESOLVED_ACTOR_TTL_MS=604800000
MAX_RESOLVED_ACTORS=5000
MAX_RESOLUTION_MEMBERSHIPS=20000
MAX_RESOLUTION_RELATED_LINKS=5
FINGERPRINT_SIMILARITY_TTL_MS=1800000
FINGERPRINT_CLEANUP_INTERVAL_MS=60000
FINGERPRINT_MAX_FLOW_CANDIDATES=3
MAX_CLIENT_FLOWS=5000
# IP가 다른 두 관찰을 하나의 Client Flow로 자동 연결할지 여부.
# 오탐률이 측정되기 전까지는 false로 끌 수 있다.
FINGERPRINT_IP_ROTATION_ENABLED=true

# Defense 대시보드
# 운영 배포에서는 GitHub Secret 또는 서버 .env로 반드시 지정하세요.
# 기존 IP로 HTTP 접속하는 운영 환경에서만 명시적으로 true로 설정하세요.
# 이 경우 두 대시보드의 HTTPS/COOKIE_SECURE와 DCID_COOKIE_SECURE를 모두 false로 설정해야 합니다.
# 비밀번호와 세션 쿠키가 네트워크에서 암호화되지 않습니다.
ALLOW_INSECURE_DASHBOARD_HTTP=false
DEFENSE_DASHBOARD_ENABLED=true
DEFENSE_DASHBOARD_PASSWORD=
DEFENSE_DASHBOARD_COOKIE_SECURE=true
DEFENSE_DASHBOARD_REQUIRE_HTTPS=true
DEFENSE_EVENT_LIMIT=5000
DEFENSE_DASHBOARD_MAX_SESSIONS=1000
DEFENSE_DASHBOARD_LOGIN_ATTEMPTS=5
DEFENSE_DASHBOARD_LOGIN_WINDOW_SECONDS=300

# Detection 대시보드. telemetry 수집 엔드포인트는 이 인증과 무관하게 공개됩니다.
DETECTION_DASHBOARD_PASSWORD=
DETECTION_DASHBOARD_COOKIE_SECURE=true
DETECTION_DASHBOARD_REQUIRE_HTTPS=true
DETECTION_DASHBOARD_MAX_SESSIONS=1000
DETECTION_DASHBOARD_LOGIN_ATTEMPTS=5
DETECTION_DASHBOARD_LOGIN_WINDOW_SECONDS=300

# Detection 신원 보존 및 XSS 비교 저장소 (변경 후 컨테이너 재생성 필요)
DETECTION_ENTITY_TTL_MS=1800000
RISKY_ENTITY_TTL_MS=86400000
DETECTION_ENTITY_SWEEP_MS=60000
MAX_SESSIONS=50000
MAX_ACTORS=50000
MAX_AUTH_GROUPS=50000
MAX_IP_ENTRIES=50000
XSS_MAX_BODY_BYTES=2000000
XSS_CANDIDATE_TTL_MS=3600000
XSS_MAX_CANDIDATES=2000
XSS_MAX_CANDIDATE_BYTES=4194304
XSS_MAX_VALUE_BYTES=4096
# Detection 의 모든 SQLite 상태는 이 파일 하나다 (detection-data 볼륨의 /app/data).
# XSS_DB_PATH / XSS_CONFIRMED_DB_PATH / XSS_REFLECTED_DB_PATH 는 더 이상 쓰지 않는다.
# 구 파일이 남아 있으면 detection/scripts/migrate-stores.js 로 한 번 옮긴다.
DETECTION_STORE_DB=/app/data/detection.sqlite3

# 오버레이의 감사 링과 미끼 링이 공유하는 텔레메트리 DB. 비워 두면 decoy TOML 의
# audit_path 를 쓴다. 격리·재생 방지 저장소(DEFENSE_SECURITY_DB)는 격리 판단이
# 텔레메트리 쓰기 락과 다투지 않도록 별도 파일로 유지한다.
DEFENSE_TELEMETRY_DB=/app/state/telemetry.sqlite3

# ---------------------------------------------------------------------------
# 영속 저장소 한눈에 보기 (컨테이너별)
#
#   detection   detection-data:/app/data
#               DETECTION_STORE_DB=/app/data/detection.sqlite3
#               (XSS 후보·확정 증거·reflected 증거·스키마 학습이 모두 이 파일)
#
#   defense     defense-alias-data:/app/alias-data
#               PATH_ALIAS_DB_PATH=/app/alias-data/path-alias.sqlite3
#               defense-overlay-data:/app/overlay-state
#               DEFENSE_OVERLAY_STATE_DB=/app/overlay-state/routes.sqlite3
#               경로 저장소는 sentinel·0600·dev/ino·user_version 으로 fail-closed 이고
#               실패가 503 이 되므로 요청마다 쓰는 별칭 테이블과 파일을 공유하지 않는다.
#
#   overlay-*   overlay-*-data:/app/state
#               DEFENSE_SECURITY_DB=/app/state/security.sqlite3   (격리·재생 방지)
#               DEFENSE_TELEMETRY_DB=/app/state/telemetry.sqlite3 (감사 + 미끼 링)
#
#   cheat-*     cheat-*-data:/data
#               DEFENSE_DB=/data/defense.db
#
# 스키마는 모두 schema_migrations(component, version, applied_at) 로 관리한다.
# 재배포 때 위 볼륨은 보존해야 한다.
#
# 구 파일에서 한 번 옮기기 (둘 다 멱등, 구 파일이 없으면 아무것도 하지 않는다):
#   docker compose exec detection node scripts/migrate-stores.js
#   docker compose exec overlay-juice python -m defense.cli \
#       --config /app/config/decoy-production-juice-v2.toml migrate-telemetry
#
# 더 이상 쓰지 않는 변수 (설정돼 있으면 Detection 이 경고를 띄운다):
#   XSS_DB_PATH, XSS_CONFIRMED_DB_PATH, XSS_REFLECTED_DB_PATH, SCHEMA_LEARNING_FILE
#   PATH_ALIAS_DB_URL, PATH_ALIAS_DB_PASSWORD, PATH_ALIAS_DB_POOL_SIZE
# ---------------------------------------------------------------------------
