{
  "schemaVersion": 1,
  "profileId": "ruby-shop",
  "label": "RUBY Market",
  "_note": "RUBY Market. 값은 저장소 안의 근거에서만 채웠다: defense/config/ruby-shop-routes.json, defense/account-response-overlay/config/site-ruby-shop.toml, 같은 패키지의 INTEGRATION.md, tests/test_production_config.py. _genericDefaults 는 generic 에서 그대로 가져온 값이고 RUBY 에서 검증되지 않았다.",
  "_needsConfirmation": [
    "loginBruteForce",
    "passwordResetAbuse",
    "priceIntegrity",
    "businessLogic.massAssignmentWhitelist",
    "roleGated",
    "identity.routeRules",
    "identity.bodyRules",
    "identity.queryRules"
  ],
  "_genericDefaults": [
    "priceTampering",
    "businessLogic.alwaysSuspiciousFields",
    "businessLogic.suspiciousRoleValues",
    "businessLogic.numericFieldRules",
    "identity.tokenSources",
    "identity.claimMap",
    "deception.plaintextBaitPaths"
  ],
  "deception": {
    "loginPath": "/api/auth/login",
    "apiPathPrefixes": [
      "/api/"
    ],
    "plaintextBaitPaths": [
      "/robots.txt",
      "/security.txt",
      "/.well-known/security.txt",
      "/metrics"
    ],
    "frontendFlavor": "fetch"
  },
  "priceTampering": {
    "quantityFields": [
      "quantity",
      "qty"
    ],
    "unitPriceFields": [
      "price",
      "unitprice",
      "itemprice"
    ],
    "totalFields": [
      "totalprice",
      "total",
      "amount",
      "ordertotal",
      "linetotal"
    ],
    "amountTolerance": 0.01
  },
  "businessLogic": {
    "alwaysSuspiciousFields": [
      "role",
      "isadmin",
      "is_admin",
      "admin",
      "permissions",
      "scope",
      "accesslevel",
      "is_staff",
      "is_superuser",
      "usertype",
      "roles",
      "authority",
      "authorities",
      "grants",
      "privilege",
      "privileges",
      "acl",
      "superuser",
      "root",
      "roleid",
      "role_id"
    ],
    "suspiciousRoleValues": [
      "admin",
      "administrator",
      "root",
      "superadmin",
      "super_admin",
      "sysadmin",
      "owner"
    ],
    "numericFieldRules": [
      {
        "field": "price",
        "min": 0.01
      },
      {
        "field": "deluxeprice",
        "min": 0
      },
      {
        "field": "quantity",
        "min": 1,
        "max": 100
      },
      {
        "field": "rating",
        "min": 1,
        "max": 5
      }
    ]
  },
  "identity": {
    "tokenSources": {
      "bearer": true,
      "cookieNames": [
        "token"
      ]
    },
    "claimMap": {
      "wrapperKey": "data",
      "id": "id",
      "email": "email",
      "role": "role",
      "basketId": {
        "at": "root",
        "key": "bid"
      }
    },
    "learnedFallback": true
  }
}
