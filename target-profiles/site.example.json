{
  "version": 1,
  "routes": {
    "login": {
      "method": "POST",
      "path": "/api/session",
      "accountField": "email",
      "failureStatuses": [401]
    },
    "passwordReset": {
      "method": "POST",
      "path": "/api/account/password-reset",
      "accountField": "email"
    }
  },
  "permissions": [
    {
      "method": "GET",
      "path": "/api/admin/reports",
      "requiredRoles": ["admin"]
    }
  ],
  "bait": {
    "traps": [
      {
        "method": "GET",
        "path": "/__ruby_bait/site-admin",
        "status": 404,
        "contentType": "text/plain",
        "body": "Not found"
      }
    ],
    "htmlPaths": ["/"],
    "plaintextPaths": []
  }
}
