{
  "registry_version": 1,
  "conditions": {
    "proxy-only": {
      "driver": "honeyval-python",
      "enabled": false,
      "source_root": "defense-component",
      "manifest_path": "configs/stage3a-defense-honeyval-v1.json",
      "lifecycle_path": "configs/stage3a-inline-defense-lifecycle-v1.json",
      "model_config_path": "configs/stage3a-defense-honeyval-model-v1.json",
      "source_files": ["honeyval-defense/src/honeyval/*.py"]
    },
    "honeyval": {
      "driver": "honeyval-python",
      "enabled": true,
      "source_root": "defense-component",
      "manifest_path": "configs/stage3a-defense-honeyval-v1.json",
      "lifecycle_path": "configs/stage3a-inline-defense-lifecycle-v1.json",
      "model_config_path": "configs/stage3a-defense-honeyval-model-v1.json",
      "source_files": ["honeyval-defense/src/honeyval/*.py"]
    },
    "static-guard": {
      "driver": "container-reverse-proxy",
      "image": "ruby-static-request-guard:1.0.0",
      "build_context": "defenses/static-guard",
      "dockerfile": "Dockerfile",
      "manifest_path": "configs/stage3a-defense-static-guard-v1.json",
      "lifecycle_path": "configs/stage3a-inline-defense-lifecycle-v1.json",
      "source_files": [
        "web-defense-benchmark/app/defenses/static-guard/Dockerfile",
        "web-defense-benchmark/app/defenses/static-guard/server.py"
      ]
    }
  }
}
