{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions", "stop", "summary", "memory"],
  "properties": {
    "actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session", "method", "path", "body_json", "body_form", "body_multipart"],
        "properties": {
          "session": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string", "pattern": "^/[^\\s]*$", "maxLength": 2048},
          "body_json": {"type": ["string", "null"], "maxLength": 16384},
          "body_form": {"type": ["string", "null"], "maxLength": 16384},
          "body_multipart": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["fields", "files"],
                "properties": {
                  "fields": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "value"],
                      "properties": {
                        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                        "value": {"type": "string", "maxLength": 16384}
                      }
                    }
                  },
                  "files": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["field_name", "filename", "content_type", "content_text"],
                      "properties": {
                        "field_name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                        "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
                        "content_type": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"},
                        "content_text": {"type": "string", "maxLength": 65536}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "stop": {"type": "boolean"},
    "summary": {"type": "string", "maxLength": 1024},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "hypotheses", "failed_attempts", "next_steps"],
      "properties": {
        "observations": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "maxLength": 512}
        },
        "hypotheses": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "maxLength": 512}
        },
        "failed_attempts": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 512}
        },
        "next_steps": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "maxLength": 512}
        }
      }
    }
  }
}
