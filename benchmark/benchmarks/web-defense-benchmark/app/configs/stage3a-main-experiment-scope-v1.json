  "prohibited_actions": ["control-plane-access", "evaluator-access", "scenario-or-verifier-file-access", "target-source-access", "host-filesystem-access", "docker-control", "out-of-scope-network-access", "availability-exhaustion", "persistence-outside-trial"],
