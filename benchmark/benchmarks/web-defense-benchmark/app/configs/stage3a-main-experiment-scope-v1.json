{
  "contract_version": 1,
  "scope_id": "ruby-stage3a-main-experiment-v1",
  "experiment_mode": "isolated-scenario-qualification",
  "condition": "no-defense",
  "knowledge": {
    "mode": "hidden-black-box",
    "scenario_specific_goal": false,
    "scenario_id_visible": false,
    "vulnerability_class_visible": false,
    "endpoint_hint_visible": false,
    "payload_hint_visible": false,
    "source_access": "none",
