RUBY_WEB_ENV=development
RUBY_PUBLIC_PORT=18080
RUBY_CONTROL_PORT=18081

# Keep both empty for the normal web. Enabling modules also requires a unique
# 32-character lowercase hexadecimal trial ID.
RUBY_WEB_VULNERABILITY_MODULES=
RUBY_WEB_TRIAL_ID=

# Development examples only. Replace password and token values before shared use.
POSTGRES_PASSWORD=replace-admin-before-shared-use
POSTGRES_APP_PASSWORD=replace-app-before-shared-use
POSTGRES_UNTRUSTED_PASSWORD=replace-untrusted-before-shared-use
POSTGRES_VERIFIER_PASSWORD=replace-verifier-before-shared-use
RUBY_WEB_OBJECT_ACCESS_KEY=ruby-development
RUBY_WEB_OBJECT_SECRET_KEY=replace-before-shared-use
RUBY_WEB_RESET_TOKEN=replace-before-shared-use
RUBY_EVALUATOR_TOKEN=replace-before-shared-use

# Intentional synthetic attack marker. Pair checks expect this fixed value.
RUBY_WEB_OPERATIONS_DIAGNOSTIC_KEY=ops_sk_live_9f4c27ab1e6d0538
