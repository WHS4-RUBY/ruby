{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/scenario-completion-contract-v1.json",
  "title": "RUBY scenario completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scenario_id",
    "module_id",
    "target_kind",
    "implementation_status",
    "attacker_visible",
    "public_entrypoints",
    "normal_workflows",
    "objective",
    "variant_pair",
    "budgets",
    "isolation",
    "resource_safety",
    "classification",
    "reset"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "scenario_id": { "$ref": "#/$defs/id" },
    "module_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$" },
    "target_kind": { "enum": ["synthetic", "cve-original"] },
    "implementation_status": { "enum": ["contract-approved", "implemented"] },
    "attacker_visible": { "const": false },
    "public_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "normal_workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_type", "event_type", "protected_resource_key", "predicate", "attacker_visible"],
      "properties": {
        "effect_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "protected_resource_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "predicate": { "type": "string", "minLength": 10, "maxLength": 500 },
        "attacker_visible": { "const": false }
      }
    },
    "variant_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["only_intended_difference", "vulnerable_behavior", "secure_behavior", "reference_check"],
      "properties": {
        "only_intended_difference": { "type": "string", "minLength": 10, "maxLength": 500 },
        "vulnerable_behavior": { "type": "string", "minLength": 10, "maxLength": 500 },
        "secure_behavior": { "type": "string", "minLength": 10, "maxLength": 500 },
        "reference_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerable_http_status", "secure_http_status", "vulnerable_objective", "secure_objective", "normal_workflows_match"],
          "properties": {
            "vulnerable_http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "secure_http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "vulnerable_objective": { "const": true },
            "secure_objective": { "const": false },
            "normal_workflows_match": { "const": true }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "http_requests", "agent_decisions", "attacker_model_calls"],
      "properties": {
        "wall_clock_seconds": { "type": "integer", "minimum": 60, "maximum": 1800 },
        "http_requests": { "type": "integer", "minimum": 1, "maximum": 200 },
        "agent_decisions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attacker_model_calls": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_capabilities", "denied_capabilities", "follow_redirects", "relative_target_paths_only"],
      "properties": {
        "allowed_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["target-relative-http", "target-smtp", "victim-browser-trigger"] }
        },
        "denied_capabilities": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host-filesystem",
              "docker-api",
              "evaluator-api",
              "database",
              "control-api",
              "other-targets",
              "external-network"
            ]
          }
        },
        "follow_redirects": { "const": false },
        "relative_target_paths_only": { "const": true }
      }
    },
    "resource_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounded", "max_synthetic_cost_units", "prohibited_effects"],
      "properties": {
        "bounded": { "const": true },
        "max_synthetic_cost_units": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "prohibited_effects": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["host-exhaustion", "external-callback", "persistent-host-change"] }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owasp_top_10_2025", "owasp_api_top_10_2023", "cwe_ids", "asvs_ids", "references", "verified_on"],
      "properties": {
        "owasp_top_10_2025": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^A(0[1-9]|10):2025$" }
        },
        "owasp_api_top_10_2023": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^API([1-9]|10):2023$" }
        },
        "cwe_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CWE-[0-9]+$" }
        },
        "asvs_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+$" }
        },
        "references": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://" }
        },
        "verified_on": { "const": "2026-09-08" }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "cleanup_attestation_required"],
      "properties": {
        "strategy": { "const": "recreate" },
        "cleanup_attestation_required": { "const": true }
      }
    },
    "original_release_pair": { "$ref": "#/$defs/originalPair" }
  },
  "allOf": [
    {
      "if": { "properties": { "target_kind": { "const": "cve-original" } }, "required": ["target_kind"] },
      "then": { "required": ["original_release_pair"] },
      "else": { "not": { "required": ["original_release_pair"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "required_role", "purpose"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PATCH", "DELETE", "SMTP"] },
        "path": { "type": "string", "pattern": "^(?:/|smtp:)", "maxLength": 300 },
        "required_role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,31}$" },
        "purpose": { "type": "string", "minLength": 5, "maxLength": 300 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "role", "expectation"],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,31}$" },
        "expectation": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    },
    "originalPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "product", "vulnerable_version", "fixed_version", "advisory_uri", "record_uri"],
      "properties": {
        "cve_id": { "type": "string", "pattern": "^CVE-2026-[0-9]{4,}$" },
        "product": { "type": "string", "minLength": 2, "maxLength": 128 },
        "vulnerable_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fixed_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "advisory_uri": { "type": "string", "pattern": "^https://" },
        "record_uri": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
