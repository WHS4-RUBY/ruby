{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/web-defense-decoy-registry-v1.json",
  "title": "Scenario decoy target registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scenario_id", "targets"],
  "properties": {
    "contract_version": { "const": 1 },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decoy_target_id", "deployment_manifest_digest", "initial_state_digest", "allowed_actions", "isolation_scope", "real_target_reentry"],
        "properties": {
          "decoy_target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "deployment_manifest_digest": { "$ref": "#/$defs/digest" },
          "initial_state_digest": { "$ref": "#/$defs/digest" },
          "allowed_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["route", "replace-response"] } },
          "isolation_scope": { "enum": ["request", "session", "principal", "device", "trial"] },
          "real_target_reentry": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
