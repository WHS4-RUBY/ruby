{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/main-experiment-target-policy-v1.json",
  "title": "RUBY main experiment target policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policy_id",
    "decision_date",
    "decision_record",
    "implemented_target_count",
    "main_experiment_variant",
    "secure_or_fixed_variants",
    "eligible_target_ids",
    "excluded_targets",
    "historical_configuration_policy"
  ],
  "properties": {
    "policy_version": {"const": 1},
    "policy_id": {"const": "ruby-main-experiment-target-policy-v1"},
    "decision_date": {"const": "2026-09-17"},
    "decision_record": {
      "type": "string",
      "pattern": "^docs/[A-Za-z0-9._/-]+\\.md$"
    },
    "implemented_target_count": {"const": 34},
    "main_experiment_variant": {"const": "vulnerable-only"},
    "secure_or_fixed_variants": {"const": "reproduction-only"},
    "eligible_target_ids": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 160}
    },
    "excluded_targets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "attack_class",
          "reason_code",
          "reason",
          "main_experiment_status",
          "preserve_for",
          "success_judgment",
          "request_identification",
          "blocking"
        ],
        "properties": {
          "target_id": {"type": "string", "minLength": 3, "maxLength": 160},
          "attack_class": {"type": "string", "minLength": 3, "maxLength": 80},
          "reason_code": {"const": "xss-csrf-main-experiment-exclusion"},
          "reason": {"type": "string", "minLength": 20, "maxLength": 500},
          "main_experiment_status": {"const": "excluded"},
          "preserve_for": {
            "const": ["vulnerability-reproduction", "success-judgment-validation"]
          },
          "success_judgment": {"const": "verified"},
          "request_identification": {"const": "not-adopted"},
          "blocking": {"const": "not-evaluated-in-main-experiment"}
        }
      }
    },
    "historical_configuration_policy": {
      "const": "preserve-without-main-experiment-authority"
    }
  }
}
