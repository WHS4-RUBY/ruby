{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/web-defense-experiment-approval-v2.json",
  "title": "RUBY web defense experiment pre-approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "experiment_id", "comparison_id", "sealed_evaluation", "scenario_manifest_digest", "public_brief_digest", "deployment_manifest_digest", "condition", "defense_manifest_digest", "baseline_qualification_digest", "attacker", "execution", "normal_traffic", "isolation", "metrics"],
  "properties": {
    "contract_version": { "const": 2 },
    "experiment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "comparison_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "sealed_evaluation": { "type": "boolean" },
    "scenario_manifest_digest": { "$ref": "#/$defs/digest" },
    "public_brief_digest": { "$ref": "#/$defs/digest" },
    "deployment_manifest_digest": { "$ref": "#/$defs/digest" },
    "condition": { "enum": ["no-defense", "defense"] },
    "defense_manifest_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "baseline_qualification_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "attacker": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "requested_model_id", "reasoning_effort", "runtime_version", "identity_evidence_policy_digest", "prompt_digest", "toolset_digest", "action_policy", "phase_sequence_prescribed", "account_creation_policy", "session_switching", "score_oracle_access"],
      "properties": {
        "provider": { "type": "string", "minLength": 2, "maxLength": 64 },
        "requested_model_id": { "type": "string", "minLength": 2, "maxLength": 256 },
        "reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runtime_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity_evidence_policy_digest": { "$ref": "#/$defs/digest" },
        "prompt_digest": { "$ref": "#/$defs/digest" },
        "toolset_digest": { "$ref": "#/$defs/digest" },
        "action_policy": { "const": "autonomous" },
        "phase_sequence_prescribed": { "const": false },
        "account_creation_policy": { "const": "application-normal-rules" },
        "session_switching": { "const": "allowed" },
        "score_oracle_access": { "const": false }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["repetitions", "fresh_state_every_trial", "completed_trial_reuse_forbidden", "randomization_block_id", "condition_order_plan_digest", "budget_calibration_digest", "power_analysis_digest", "trial_budget", "attacker_budget", "defense_budget"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 3 },
        "fresh_state_every_trial": { "const": true },
        "completed_trial_reuse_forbidden": { "const": true },
        "randomization_block_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "condition_order_plan_digest": { "$ref": "#/$defs/digest" },
        "budget_calibration_digest": { "$ref": "#/$defs/digest" },
        "power_analysis_digest": { "$ref": "#/$defs/digest" },
        "trial_budget": {
          "type": "object", "additionalProperties": false,
          "required": ["wall_clock_seconds", "http_requests", "agent_steps"],
          "properties": {
            "wall_clock_seconds": { "type": "integer", "minimum": 60 },
            "http_requests": { "type": "integer", "minimum": 1 },
            "agent_steps": { "type": "integer", "minimum": 1 }
          }
        },
        "attacker_budget": { "$ref": "#/$defs/modelBudget" },
        "defense_budget": { "oneOf": [{ "$ref": "#/$defs/modelBudget" }, { "type": "null" }] }
      }
    },
    "normal_traffic": {
      "type": "object", "additionalProperties": false,
      "required": ["workload_manifest_digest", "schedule_digest", "seed_digest", "same_gateway_path", "concurrent_users", "duration_seconds", "account_set_digest", "includes_browser_users", "includes_benign_agents"],
      "properties": {
        "workload_manifest_digest": { "$ref": "#/$defs/digest" },
        "schedule_digest": { "$ref": "#/$defs/digest" },
        "seed_digest": { "$ref": "#/$defs/digest" },
        "same_gateway_path": { "const": true },
        "concurrent_users": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "integer", "minimum": 60 },
        "account_set_digest": { "$ref": "#/$defs/digest" },
        "includes_browser_users": { "const": true },
        "includes_benign_agents": { "const": true }
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator_hidden", "scenario_manifest_unmounted", "verifier_manifest_unmounted", "target_source_unmounted", "cross_trial_state_forbidden", "control_plane_access", "docker_socket_mounted", "opaque_trial_ids"],
      "properties": {
        "evaluator_hidden": { "const": true },
        "scenario_manifest_unmounted": { "const": true },
        "verifier_manifest_unmounted": { "const": true },
        "target_source_unmounted": { "type": "boolean" },
        "cross_trial_state_forbidden": { "const": true },
        "control_plane_access": { "const": false },
        "docker_socket_mounted": { "const": false },
        "opaque_trial_ids": { "const": true }
      }
    },
    "metrics": {
      "type": "array", "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "objective-success" } }, { "contains": { "const": "wall-clock" } },
        { "contains": { "const": "http-requests" } }, { "contains": { "const": "false-positive" } },
        { "contains": { "const": "defense-latency" } }, { "contains": { "const": "defense-error" } },
        { "contains": { "const": "budget-exhaustion" } }, { "contains": { "const": "model-usage" } }
      ],
      "items": { "enum": ["objective-success", "wall-clock", "http-requests", "agent-steps", "model-usage", "account-switches", "session-switches", "false-positive", "normal-workflow-completion", "defense-latency", "defense-error", "decoy-dwell-time", "decoy-reentry", "budget-exhaustion"] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "condition": { "const": "no-defense" } } },
      "then": {
        "properties": {
          "defense_manifest_digest": { "type": "null" },
          "baseline_qualification_digest": { "type": "null" },
          "execution": { "properties": { "defense_budget": { "type": "null" } } }
        }
      },
      "else": {
        "properties": {
          "defense_manifest_digest": { "$ref": "#/$defs/digest" },
          "baseline_qualification_digest": { "$ref": "#/$defs/digest" },
          "execution": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "sealed_evaluation": { "const": true } } },
      "then": { "properties": { "isolation": { "properties": { "target_source_unmounted": { "const": true } } } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "modelBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["model_calls", "input_tokens", "output_tokens", "retries", "max_concurrency", "cache_policy"],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 }, "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }, "retries": { "type": "integer", "minimum": 0 },
        "max_concurrency": { "type": "integer", "minimum": 1 }, "cache_policy": { "enum": ["disabled", "provider-default-recorded", "fixed-recorded"] }
      }
    }
  }
}
