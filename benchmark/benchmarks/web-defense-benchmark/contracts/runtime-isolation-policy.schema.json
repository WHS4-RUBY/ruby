{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/runtime-isolation-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "probe_image",
    "maximum_pids",
    "forbidden_dns_names",
    "direct_network_probes",
    "original_cve_targets",
    "managed_defenses"
  ],
  "properties": {
    "policy_version": {"const": 1},
    "probe_image": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"},
    "maximum_pids": {"type": "integer", "minimum": 32, "maximum": 1024},
    "forbidden_dns_names": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 128}
    },
    "direct_network_probes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "original_cve_targets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/target"}
    },
    "managed_defenses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/defense"}
    }
  },
  "$defs": {
    "linuxCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID"]
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "host", "port"],
      "properties": {
        "label": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "host": {"type": "string", "minLength": 3, "maxLength": 128},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "releases", "allowed_cap_add"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^cve-original:CVE-[0-9]{4}-[0-9]{4,}$"},
        "releases": {"const": ["vulnerable", "fixed"]},
        "allowed_cap_add": {"$ref": "#/$defs/linuxCapabilities"}
      }
    },
    "defense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "allowed_cap_add", "require_read_only"],
      "properties": {
        "condition_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "allowed_cap_add": {"$ref": "#/$defs/linuxCapabilities"},
        "require_read_only": {"const": true}
      }
    }
  }
}
