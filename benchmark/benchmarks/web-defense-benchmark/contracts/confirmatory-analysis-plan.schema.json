{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/contracts/confirmatory-analysis-plan.schema.json",
  "title": "RUBY confirmatory campaign analysis plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "analysis_id",
    "execution",
    "qualification",
    "primary_comparison",
    "confidence_level",
    "alpha",
    "power",
    "expected_joint_outcomes",
    "invalid_trial_statuses",
    "normal_traffic"
  ],
  "properties": {
    "plan_version": {"const": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ids",
        "providers",
        "attacker_profile_id",
        "attacker_profile_sealed_input",
        "attacker_profile_sha256",
        "reasoning_effort",
        "schedule_seed",
        "maximum_parallel_trials",
        "confirmatory_repetitions",
        "trial_limits"
      ],
      "properties": {
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["codex", "claude"]}
        },
        "attacker_profile_id": {"type": "string", "minLength": 1},
        "attacker_profile_sealed_input": {
          "type": "string",
          "pattern": "^configs/[A-Za-z0-9._/-]+\\.json$"
        },
        "attacker_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "schedule_seed": {"type": "integer", "minimum": 0},
        "maximum_parallel_trials": {"type": "integer", "minimum": 1},
        "confirmatory_repetitions": {"type": "integer", "minimum": 1},
        "trial_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_clock_seconds",
            "active_http_requests",
            "agent_decisions",
            "model_calls_per_trial"
          ],
          "properties": {
            "wall_clock_seconds": {"type": "integer", "minimum": 1},
            "active_http_requests": {"type": "integer", "minimum": 1},
            "agent_decisions": {"type": "integer", "minimum": 1},
            "model_calls_per_trial": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "minimum_trials", "minimum_success_rate"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "minimum_trials": {"type": "integer", "minimum": 1},
        "minimum_success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "primary_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_condition", "treatment_condition", "effect_direction"],
      "properties": {
        "control_condition": {"type": "string", "minLength": 1},
        "treatment_condition": {"type": "string", "minLength": 1},
        "effect_direction": {"const": "control-minus-treatment-attack-success"}
      }
    },
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "expected_joint_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["both_succeed", "control_only", "treatment_only", "neither_succeeds"],
      "properties": {
        "both_succeed": {"type": "number", "minimum": 0, "maximum": 1},
        "control_only": {"type": "number", "minimum": 0, "maximum": 1},
        "treatment_only": {"type": "number", "minimum": 0, "maximum": 1},
        "neither_succeeds": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "invalid_trial_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normal_traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_post_attachment_probe", "require_all_workflows", "maximum_blocked_requests", "maximum_defense_errors"],
      "properties": {
        "require_post_attachment_probe": {"const": true},
        "require_all_workflows": {"const": true},
        "maximum_blocked_requests": {"type": "integer", "minimum": 0},
        "maximum_defense_errors": {"type": "integer", "minimum": 0}
      }
    }
  }
}
