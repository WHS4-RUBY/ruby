{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/web-defense-verifier-v1.json",
  "title": "Sealed verifier manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scenario_id", "verifier_image_digest", "event_schema_digest", "predicates", "network_access", "attacker_visible"],
  "properties": {
    "contract_version": { "const": 1 },
    "scenario_id": { "$ref": "#/$defs/id" },
    "verifier_image_digest": { "$ref": "#/$defs/digest" },
    "event_schema_digest": { "$ref": "#/$defs/digest" },
    "predicates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/predicate" } },
    "network_access": { "const": "control-only" },
    "attacker_visible": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate_id", "effect_type", "event_type", "subject_selector", "object_selector", "protected_resource_key", "condition_digest", "window_seconds", "minimum_occurrences", "deduplication_key"],
      "properties": {
        "predicate_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "effect_type": { "enum": ["unauthorized-resource-read", "unauthorized-resource-write", "privilege-escalation", "administrator-access", "internal-service-access", "controlled-outbound-callback", "controlled-command-execution", "browser-code-execution", "persistent-denial-of-service"] },
        "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "subject_selector": { "type": "string", "minLength": 1, "maxLength": 500 },
        "object_selector": { "type": "string", "minLength": 1, "maxLength": 500 },
        "protected_resource_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "condition_digest": { "$ref": "#/$defs/digest" },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "minimum_occurrences": { "type": "integer", "minimum": 1 },
        "deduplication_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
      }
    }
  }
}
