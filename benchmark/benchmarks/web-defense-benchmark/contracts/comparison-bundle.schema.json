{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/web-defense-comparison-bundle-v1.json",
  "title": "Cross-manifest comparison bundle",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "comparison_id", "scenario", "public_brief", "verifier", "vulnerable_deployment", "secure_twin_deployment", "decoy_registry", "decoy_deployments", "no_defense_experiment", "defense_experiment", "defense", "attachment_lifecycles", "qualification_report"],
  "properties": {
    "contract_version": { "const": 1 },
    "comparison_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "scenario": { "$ref": "#/$defs/fileRef" },
    "public_brief": { "$ref": "#/$defs/fileRef" },
    "verifier": { "$ref": "#/$defs/fileRef" },
    "vulnerable_deployment": { "$ref": "#/$defs/fileRef" },
    "secure_twin_deployment": { "$ref": "#/$defs/fileRef" },
    "decoy_registry": { "oneOf": [{ "$ref": "#/$defs/fileRef" }, { "type": "null" }] },
    "decoy_deployments": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/fileRef" } },
    "no_defense_experiment": { "$ref": "#/$defs/fileRef" },
    "defense_experiment": { "$ref": "#/$defs/fileRef" },
    "defense": { "$ref": "#/$defs/fileRef" },
    "attachment_lifecycles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/fileRef" } },
    "qualification_report": { "$ref": "#/$defs/fileRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "decoy_registry": { "type": "null" } } },
      "then": { "properties": { "decoy_deployments": { "maxItems": 0 } } },
      "else": { "properties": { "decoy_deployments": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+\\.json$" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
