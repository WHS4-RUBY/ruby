{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/defense-runtime-registry-v2.json",
  "title": "RUBY defense runtime registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "conditions"],
  "properties": {
    "registry_version": { "const": 2 },
    "conditions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
      "additionalProperties": { "$ref": "#/$defs/registration" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_mb", "cpus", "pids", "tmpfs_mb"],
      "properties": {
        "memory_mb": { "type": "integer", "minimum": 32, "maximum": 8192 },
        "cpus": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
        "pids": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "path_scope": { "enum": ["benchmark", "repository"] },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "lifecycle_path": { "$ref": "#/$defs/relativePath" },
        "model_config_path": { "$ref": "#/$defs/relativePath" },
        "secret_env_names": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
        }
      }
    },
    "managedContainer": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "path_scope", "manifest_path", "lifecycle_path", "image", "control_port", "secret_env_names", "resource_limits", "network_policy"],
          "properties": {
            "driver": { "const": "managed-container" },
            "path_scope": { "enum": ["benchmark", "repository"] },
            "manifest_path": { "$ref": "#/$defs/relativePath" },
            "lifecycle_path": { "$ref": "#/$defs/relativePath" },
            "model_config_path": { "$ref": "#/$defs/relativePath" },
            "image": { "type": "string", "minLength": 3, "maxLength": 512 },
            "control_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "secret_env_names": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
            },
            "resource_limits": { "$ref": "#/$defs/resourceLimits" },
            "network_policy": { "enum": ["isolated", "internet-egress"] },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context", "dockerfile", "source_files"],
              "properties": {
                "context": { "$ref": "#/$defs/relativePath" },
                "dockerfile": { "$ref": "#/$defs/relativePath" },
                "source_files": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/relativePath" }
                }
              }
            }
          },
          "anyOf": [
            { "required": ["build"] },
            { "properties": { "image": { "pattern": "@sha256:[a-f0-9]{64}$" } } }
          ]
        }
      ]
    },
    "externalHttp": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "path_scope", "manifest_path", "lifecycle_path", "secret_env_names"],
          "properties": {
            "driver": { "const": "external-http" },
            "path_scope": { "enum": ["benchmark", "repository"] },
            "manifest_path": { "$ref": "#/$defs/relativePath" },
            "lifecycle_path": { "$ref": "#/$defs/relativePath" },
            "model_config_path": { "$ref": "#/$defs/relativePath" },
            "endpoint": {
              "type": "string",
              "pattern": "^http://(?:127\\.0\\.0\\.1|localhost):[0-9]{1,5}$"
            },
            "endpoint_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
            "secret_env_names": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
            }
          },
          "oneOf": [
            { "required": ["endpoint"], "not": { "required": ["endpoint_env"] } },
            { "required": ["endpoint_env"], "not": { "required": ["endpoint"] } }
          ]
        }
      ]
    },
    "registration": {
      "oneOf": [
        { "$ref": "#/$defs/managedContainer" },
        { "$ref": "#/$defs/externalHttp" }
      ]
    }
  }
}
