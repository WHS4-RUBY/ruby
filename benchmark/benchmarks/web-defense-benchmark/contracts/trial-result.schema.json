{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruby.local/schemas/web-defense-trial-result-v1.json",
  "title": "Immutable trial result",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "trial_id", "experiment_manifest_digest", "condition", "status", "attacker_model", "defense_model", "reset_attestation_digest", "event_ledger_digest", "request_trace_digest", "metrics"],
  "properties": {
    "contract_version": { "const": 1 },
    "trial_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "experiment_manifest_digest": { "$ref": "#/$defs/digest" },
    "condition": { "enum": ["no-defense", "defense"] },
    "status": { "enum": ["objective-achieved", "attack-failed", "budget-exhausted", "invalid-defense-error", "verifier-error", "runner-error", "cancelled"] },
    "attacker_model": { "$ref": "#/$defs/modelEvidence" },
    "defense_model": { "oneOf": [{ "$ref": "#/$defs/modelEvidence" }, { "type": "null" }] },
    "reset_attestation_digest": { "$ref": "#/$defs/digest" },
    "event_ledger_digest": { "$ref": "#/$defs/digest" },
    "request_trace_digest": { "$ref": "#/$defs/digest" },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_success", "wall_clock_seconds", "http_requests", "agent_steps", "attacker_model_calls", "attacker_input_tokens", "attacker_output_tokens", "defense_model_calls", "defense_input_tokens", "defense_output_tokens", "account_switches", "session_switches", "false_positives", "normal_workflow_completed", "defense_latency_ms", "defense_errors", "decoy_dwell_seconds", "decoy_reentries", "budget_exhausted"],
      "properties": {
        "objective_success": { "type": "boolean" }, "wall_clock_seconds": { "type": "number", "minimum": 0 },
        "http_requests": { "type": "integer", "minimum": 0 }, "agent_steps": { "type": "integer", "minimum": 0 },
        "attacker_model_calls": { "type": "integer", "minimum": 0 }, "attacker_input_tokens": { "type": "integer", "minimum": 0 },
        "attacker_output_tokens": { "type": "integer", "minimum": 0 }, "defense_model_calls": { "type": "integer", "minimum": 0 },
        "defense_input_tokens": { "type": "integer", "minimum": 0 }, "defense_output_tokens": { "type": "integer", "minimum": 0 },
        "account_switches": { "type": "integer", "minimum": 0 },
        "session_switches": { "type": "integer", "minimum": 0 }, "false_positives": { "type": "integer", "minimum": 0 },
        "normal_workflow_completed": { "type": "boolean" }, "defense_latency_ms": { "type": "number", "minimum": 0 },
        "defense_errors": { "type": "integer", "minimum": 0 }, "decoy_dwell_seconds": { "type": "number", "minimum": 0 },
        "decoy_reentries": { "type": "integer", "minimum": 0 }, "budget_exhausted": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "condition": { "const": "no-defense" } } },
      "then": { "properties": { "defense_model": { "type": "null" } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "modelEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_model_id", "observed_model_ids", "identity_source", "identity_match", "evidence_digest"],
      "properties": {
        "requested_model_id": { "type": "string", "minLength": 2, "maxLength": 256 },
        "observed_model_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 256 } },
        "identity_source": { "enum": ["response-metadata", "cli-audit", "provider-log", "local-runtime"] },
        "identity_match": { "type": "boolean" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
