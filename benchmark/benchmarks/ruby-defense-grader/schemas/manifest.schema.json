{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUBY Defense Grader Run Manifest v0.2",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "run_id", "scenario_id", "attack_mode", "defense", "seed", "budget", "artifact_dir", "artifact_sha256"],
    "properties": {
      "schema_version": {"const": "0.2"},
      "run_id": {"type": "string", "minLength": 1},
      "scenario_id": {"type": "string", "minLength": 1},
      "attack_mode": {"enum": ["fixed", "agent"]},
      "defense": {"enum": ["baseline", "defended"]},
      "seed": {"type": "integer"},
      "budget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["max_attempts", "max_time_ms", "max_tokens"],
        "properties": {
          "max_attempts": {"type": "integer", "minimum": 1},
          "max_time_ms": {"type": "integer", "minimum": 1},
          "max_tokens": {"type": "integer", "minimum": 1}
        }
      },
      "artifact_dir": {"type": "string", "minLength": 1},
      "artifact_sha256": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state.json", "events.jsonl", "usage.json", "controls.json"],
        "properties": {
          "state.json": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "events.jsonl": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "usage.json": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "controls.json": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}
