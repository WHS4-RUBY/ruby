map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name _;
    absolute_redirect off;
    client_max_body_size 0;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto @FORWARDED_PROTO@;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location = / {
        return 302 /@PUBLIC_NAME@/;
    }

    location = /@PUBLIC_NAME@ {
        return 308 /@PUBLIC_NAME@/;
    }

    # Only the selected site's named path is live. Strip that prefix before
    # Detection so its route rules and the target app see their original paths.
    location ^~ /@PUBLIC_NAME@/ {
        proxy_pass http://detection:8080/;
    }

    # Do not let a stale bookmark display the selected site under the other
    # built-in site's name.
    location ~ ^/(juice-shop|ruby-market)(/|$) {
        return 404;
    }

    # Both example frontends use root-absolute API/assets paths. Keep those,
    # management paths, and WebSocket upgrades on the same active pipeline.
    location / {
        proxy_pass http://detection:8080;
    }
}
